{
  "name": "jrs-swp",
  "version": "0.1.0",
  "description": "SWP-1, the source-provenance watermark: embed, verify and recover a keyed mark across a source tree, from Node.js. Native addon over the swp-sdk façade; TypeScript declarations included.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/theaaqibjavaid/SWP-1.git",
    "directory": "bindings/node"
  },
  "main": "index.js",
  "types": "binding.d.ts",
  "engines": {
    "node": "^20.17.0 || ^22.13.0 || >=23.5.0"
  },
  "keywords": [
    "watermarking",
    "provenance",
    "supply-chain",
    "code-analysis"
  ],
  "files": [
    "index.js",
    "binding.cjs",
    "binding.d.ts",
    "README.md",
    "*.node"
  ],
  "napi": {
    "binaryName": "swp",
    "targets": [
      "x86_64-pc-windows-msvc",
      "x86_64-unknown-linux-gnu",
      "aarch64-apple-darwin",
      "x86_64-apple-darwin"
    ]
  },
  "scripts": {
    "build": "napi build --platform --release --js binding.cjs --dts binding.d.ts",
    "build:dev": "napi build --platform --js binding.cjs --dts binding.d.ts",
    "test": "node --test",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.10.5"
  }
}
